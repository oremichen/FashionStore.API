vservices:
  sqlserver:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: fashionstore-sqlserver
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: "Developer"
      # SA_PASSWORD: "FashionStore123!"
    ports:
      - "1433:1433"
    volumes:
      - sqlserver-data:/var/opt/mssql
    healthcheck:
      test: /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "FashionStore123!" -C -Q "SELECT 1" || exit 1
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s

  api:
    container_name: fashionstore-api
    build:
      context: .
      dockerfile: FashionStore.API/Dockerfile
    depends_on:
      sqlserver:
        condition: service_healthy
    environment:
      ASPNETCORE_ENVIRONMENT: "Docker"
      ASPNETCORE_URLS: "http://+:8080"
      ConnectionStrings__DefaultConnection: "Server=sqlserver,1433;Database=FashionStoreDb;Encrypt=False;TrustServerCertificate=True;"
    ports:
      - "8080:8080"

volumes:
  sqlserver-data:
