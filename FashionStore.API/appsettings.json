{
  "RedisCache": {
    "AbsoluteExpirationHours": 24,
    "KeyPrefix": "fashion-store"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level}] [{SourceContext}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Serilogs/log-.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": "2100000",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level}] [{SourceContext}] {Message}{NewLine}{Exception}",
          "retainedFileCountLimit": null,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "", "" ]
  },
  "AppSettings": {
    "AppName": ""
  },
  "EmailTemplates": {
    "AssetsBaseUrl": "http://localhost:3000"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Paystack": {
    "BaseUrl": "https://api.paystack.co",
    "SecretKey": ""
  },
  "SeedData": {
    "SuperAdmin": {
      "Email": "",
      "Password": "",
      "FirstName": "",
      "LastName": ""
    }
  },
  "EncryptionSettings": {
    "RsaPublicKeyPem": "",
    "RsaPrivateKeyPem": ""
  },
  "Frontend": {
    "ConfirmationPageUrl": "https://themaisondelola.com/confirm-email",
    "LoginPageUrl": "https://themaisondelola.com/sign-in",
    "PaymentCallbackUrl": "https://themaisondelola.com/checkout/payment-callback"
  },
  "NotificationSettings": {
    "RetryCount": 3,
    "RetryDelaySeconds": 5,
    "ProcessingRecoveryDelaySeconds": 60
  },
  "ConnectionStrings": {
    "_DefaultConnection": "Server=localhost;Port=5432;Database=FashionStoreDb;User Id=postgres;Password=1234;Include Error Detail=true",
    "DefaultConnection": "",
    "Redis": ""
  },
  "EmailProviders": {
    "ProviderOrder": [ "Postmark" ],
    "Postmark": {
      "ServerToken": "233b61ec-78b8-4129-8333-3130d2ff192c",
      "MessageStream": "notification",
      "TrackOpens": true,
      "DefaultFromAddress": "maisondelola@themaisondelola.com",
      "DefaultFromName": "MaisonDeLola"
    },
    "AmazonSes": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true,
      "ConfigurationSet": "",
      "DefaultFromAddress": "maisondelola@themaisondelola.com",
      "DefaultFromName": "MaisonDeLola"
    }
  },
  "JwtSettings": {
    "Issuer": "",
    "Audience": "",
    "Secret": ""
  }
}
