{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level}] [{SourceContext}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Serilogs/log-.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": "2100000",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level}] [{SourceContext}] {Message}{NewLine}{Exception}",
          "retainedFileCountLimit": null,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4000" ]
  },
  "Frontend": {
    "ConfirmationPageUrl": "http://localhost:4200/confirm-email"
  },
  "NotificationSettings": {
    "RetryCount": 3,
    "RetryDelaySeconds": 5
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5433;Database=FashionStoreDb;User Id=postgres;Password=1234;Include Error Detail=true"
  },
